# FillForm Backend Environment Variables
# Copy this file from .env.example, then fill in your values.

# Groq API key for AI-powered document analysis
GROQ_API_KEY=your-groq-api-key

# Flask session secret key (generate a random string for production)
SECRET_KEY=your-secret-key

# Google OAuth Client (User Login)
GOOGLE_LOGIN_CLIENT_ID=your-google-login-client-id.apps.googleusercontent.com
GOOGLE_LOGIN_CLIENT_SECRET=your-google-login-client-secret
